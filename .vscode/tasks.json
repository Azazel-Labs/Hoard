{
  // Everything goes through `cargo xtask` so the terminal and the editor do the same thing.
  // Ctrl+Shift+B runs "dev"; "Tasks: Run Task" lists the rest.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "hoardd + Vite with hot reload (http://127.0.0.1:5173)",
      "type": "shell",
      "command": "cargo xtask dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"],
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "dev + local model",
      "detail": "Also runs a local model server; pick a model in Settings",
      "type": "shell",
      "command": "cargo xtask dev --llm",
      "isBackground": true,
      "problemMatcher": ["$rustc"],
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "ci",
      "detail": "fmt, clippy -D warnings, tests, web build",
      "type": "shell",
      "command": "cargo xtask ci",
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "web: build",
      "type": "shell",
      "command": "cargo xtask web",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "web: vite",
      "detail": "Vite dev server only (for the browser debug configuration)",
      "type": "npm",
      "script": "dev",
      "path": "web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activeBegins": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    {
      "label": "llm: serve",
      "detail": "Run the local model server (llama.cpp); writes .vscode/llm.env for the debugger",
      "type": "shell",
      "command": "cargo xtask llm --env-file .vscode/llm.env",
      "isBackground": true,
      "problemMatcher": {
        "owner": "llama",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activeBegins": true, "beginsPattern": "Starting", "endsPattern": "is ready" }
      },
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "sample: upload",
      "detail": "Generate the sample pack and upload it to the running server",
      "type": "shell",
      "command": "cargo xtask sample --upload",
      "problemMatcher": []
    },
    {
      "label": "build: hoardd",
      "type": "cargo",
      "command": "build",
      "args": ["-p", "hoardd"],
      "problemMatcher": ["$rustc"]
    }
  ]
}
