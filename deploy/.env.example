# Copy to deploy/.env and fill in. Never commit the real file.

# Bucket + key Garage creates on first start (Garage >= 2.3 with --single-node --default-bucket).
GARAGE_DEFAULT_BUCKET=hoard
GARAGE_DEFAULT_ACCESS_KEY=GK_replace_with_GK_plus_32_hex      # "GK$(openssl rand -hex 16)"
GARAGE_DEFAULT_SECRET_KEY=replace_with_64_hex                 # "$(openssl rand -hex 32)"

# Bearer token for uploads/edits/admin and MCP write tools.
HOARD_TOKEN=replace_me

# Image tag: latest (every release), 0.8 (patch releases of 0.8), 0.8.1 (pinned) or edge (every green main commit).
# HOARD_VERSION=latest
# When Watchtower looks for a new image (cron with a leading seconds field; default 04:00 daily).
# HOARD_UPDATE_SCHEDULE=0 0 4 * * *
# Set false to stop the server checking GitHub daily for a newer release (the header badge). Also in Settings.
# HOARD_UPDATE_CHECK=true

# Intel/AMD GPU via compose.gpu-dri.yml: the host's render group id, `getent group render | cut -d: -f3`.
# RENDER_GID=

# AI tagging is set up in the portal: Settings → AI tagging. Pick "Local model" to download a model into the compose
# files' `llm` service, or a hosted service (OpenRouter, OpenAI, Anthropic, Gemini) or your own server.

# Workers, upload limits, the SoundFont and thumbnails are in Settings too; HOARD_WORKERS etc. only set the start.

# Address you reach Hoard at (used for absolute links handed to MCP clients), e.g. http://192.168.50.10:7878
# HOARD_PUBLIC_URL=

# HTTPS. compose.private.yml turns on a self-signed certificate; list the names/IPs you type into the browser so
# it covers them. HTTP/3 (QUIC over UDP) is experimental.
# HOARD_TLS_NAMES=192.168.50.10,nas.local
# HOARD_HTTP3=true

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels), for compose files that include cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=

# Tailscale auth key (admin console > Settings > Keys), for compose files that include tailscale.
TS_AUTHKEY=

# Unreal packs: convert .uasset content to PNG/EXR/WAV/JSON after ingest (off | keep | replace).
# HOARD_UNREAL_CONVERT=keep
