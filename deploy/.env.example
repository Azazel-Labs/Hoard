# Copy to deploy/.env and fill in. Never commit the real file.

# Bucket + key Garage creates on first start (Garage >= 2.3 with --single-node --default-bucket).
GARAGE_DEFAULT_BUCKET=hoard
GARAGE_DEFAULT_ACCESS_KEY=GK_replace_with_GK_plus_32_hex      # "GK$(openssl rand -hex 16)"
GARAGE_DEFAULT_SECRET_KEY=replace_with_64_hex                 # "$(openssl rand -hex 32)"

# Intel/AMD GPU via compose.gpu-dri.yml: the host's render group id, `getent group render | cut -d: -f3`.
# RENDER_GID=

# Everything else is either written straight into the compose file (the image tag, HTTPS) or
# changed in the portal's Settings (AI tagging, Blender, ffmpeg, Unreal conversion, workers, limits, public address).

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels), for compose files that include cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=

# Tailscale auth key (admin console > Settings > Keys), for compose files that include tailscale.
TS_AUTHKEY=
